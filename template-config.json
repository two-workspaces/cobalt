{
  "services": {
    "a828a421-21af-425d-adc5-e8b9e7637805": {
      "icon": "https://cdn.jsdelivr.net/npm/@tabler/icons@3.34.1/icons/outline/download.svg",
      "name": "Cobalt",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/two-workspaces/cobalt:IMAGE_TAG"
      },
      "variables": {
        "PORT": {
          "defaultValue": "9000",
          "description": "Port Cobalt listens on - leave as is",
          "isOptional": false
        },
        "API_PORT": {
          "defaultValue": "9000",
          "description": "Same port, the variable Cobalt reads - leave as is",
          "isOptional": false
        },
        "API_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}/",
          "description": "Public URL of this instance, used in download links - set it to your custom domain when you add one",
          "isOptional": false
        },
        "COBALT_API_KEY": {
          "defaultValue": "${{secret(8, \"0123456789abcdef\")}}-${{secret(4, \"0123456789abcdef\")}}-4${{secret(3, \"0123456789abcdef\")}}-a${{secret(3, \"0123456789abcdef\")}}-${{secret(12, \"0123456789abcdef\")}}",
          "description": "Access key every request needs - auto-generated, paste it into cobalt.tools under Settings > Instances",
          "isOptional": false
        },
        "YOUTUBE_SESSION_SERVER": {
          "defaultValue": "http://${{YouTube-Tokens.RAILWAY_PRIVATE_DOMAIN}}:4416/",
          "description": "PO token server for YouTube - private network, leave as is",
          "isOptional": false
        },
        "DURATION_LIMIT": {
          "defaultValue": "10800",
          "description": "Longest video Cobalt will process, in seconds (3 hours)",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      }
    },
    "9e89846b-b02d-4509-89f3-0b94e7941ff1": {
      "icon": "https://cdn.jsdelivr.net/npm/@tabler/icons@3.34.1/icons/outline/brand-youtube.svg",
      "name": "YouTube-Tokens",
      "build": {},
      "deploy": {
        "startCommand": "node build/main.js --host ::",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "brainicism/bgutil-ytdlp-pot-provider:2.0.2-node"
      },
      "variables": {},
      "networking": {
        "serviceDomains": {}
      }
    }
  }
}